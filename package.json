{
  "name": "ruleon",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "node scripts/ensure-electron.mjs && env -u ELECTRON_RUN_AS_NODE vite --mode electron",
    "preview:electron": "env -u ELECTRON_RUN_AS_NODE electron .",
    "postinstall": "node scripts/ensure-electron.mjs",
    "build": "tsc -b && vite build",
    "build:e2e": "tsc -b && VITE_E2E=1 vite build",
    "dev:e2e": "VITE_E2E=1 vite --host 127.0.0.1 --port 5173 --strictPort",
    "preview:e2e": "vite preview --host 127.0.0.1 --port 5173 --strictPort",
    "build:electron": "tsc -b && vite build --mode electron && electron-builder",
    "build:electron:dir": "tsc -b && vite build --mode electron && electron-builder --dir",
    "lint": "eslint .",
    "preview": "vite preview",
    "check:lines": "node scripts/check-lines.js",
    "test": "npm run test:logic && npm run test:e2e",
    "test:logic": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tiptap/core": "^3.26.0",
    "@tiptap/extension-placeholder": "^3.26.0",
    "@tiptap/react": "^3.26.0",
    "@tiptap/starter-kit": "^3.26.0",
    "@vlcn.io/crsqlite-wasm": "0.16.0",
    "@vlcn.io/rx-tbl": "0.15.0",
    "@vlcn.io/ws-browserdb": "^0.2.0",
    "@vlcn.io/ws-client": "^0.2.0",
    "lucide-react": "^1.17.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.19.20",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^35.7.5",
    "electron-builder": "^25.1.8",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.24.1",
    "vite": "^6.2.0",
    "vite-plugin-electron": "^0.29.1",
    "vite-plugin-electron-renderer": "^0.14.7",
    "vitest": "^3.0.9"
  }
}
