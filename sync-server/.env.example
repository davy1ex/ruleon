# Run ./setup.sh to generate .env and print connection settings for Ruleon.
# Required. Clients must send the same value in Settings → Sync → API key.
API_KEY=change-me-to-a-long-random-secret
PORT=8080

# Schema version is derived from schemas/ruleon (cryb64 hash). Clients must
# match automatically after app update; re-run ./setup.sh after schema.sql changes.
